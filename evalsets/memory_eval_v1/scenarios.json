      }
    },
    {
      "scenario_id": "scenario_noop_low_value_filter",
      "title": "无价值/当前状态类输入过滤",
      "mode": "sequential",
      "turn_ids": [
        "turn_38dadb00a1fea17d1a860cd5676814e4599f3cfa6955f407e6f3fab2ad4a5937",
        "turn_5bac64c1dba63fe209e923027ed0a2776d813567b6569fb90ed1c134db83b5e7",
        "turn_6de92bc87542233247f7085bd911e9d26ae522c7590523caf802ff0949c42eb5",
        "turn_1b834671a9be2efae922c321600037e6ddd631ebf39443f8ea113d7bd2ca4d96",
        "turn_5d83de860d4704395134b82544a5d8f30d94aa0e4bd13dfadeae8af941ee360e"
      ],
      "expected": {
        "should_actions_mostly": ["noop"],
        "quality_target": "A"
